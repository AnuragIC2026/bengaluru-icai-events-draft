# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=production
PORT=4000

# Database. Leave MONGODB_URI empty to use the in-memory test database (data lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/bengaluru_icai_events

# Long random text, at least 32 characters. Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_HOURS=8

# Where the front end is (GitHub Pages or the events subdomain), and this API's public address
FRONTEND_URL=https://events.bangaloreicai.org
CORS_ORIGINS=https://events.bangaloreicai.org
PUBLIC_API_URL=https://events-api.bangaloreicai.org
# Set to true when running behind Nginx or another proxy
TRUST_PROXY=true
UPLOAD_DIR=/var/lib/bengaluru-icai-events/uploads

# Admin logins, created or updated by: npm run seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Branch admin
ACCOUNTS_EMAIL=
ACCOUNTS_PASSWORD=
ACCOUNTS_NAME=Accounts team

# Payments: test (simulated bank) or eazypay (real ICICI Eazypay)
PAYMENT_MODE=test
EAZYPAY_MERCHANT_ID=
EAZYPAY_SUB_MERCHANT_ID=
# 16 character AES key from ICICI
EAZYPAY_AES_KEY=
EAZYPAY_PAYMODE=9
# Exact list comes in ICICI's merchant kit. Placeholders: {ref} {sub} {amount} {name} {mobile} {email}
EAZYPAY_MANDATORY_FIELDS={ref}|{sub}|{amount}
EAZYPAY_URL=https://eazypay.icicibank.com/EazyPG

# Emails (booking receipt and participant confirmations)
EMAIL_ENABLED=false
EMAIL_FROM=Bengaluru ICAI Events <events@bangaloreicai.org>
EMAIL_REPLY_TO=blrregistrations@icai.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
